utton\" value=\"LightVideo\" name=\"codeLightVideo\" title=\"Видео в окне (Ctrl+V)\" style=\"width: 68px\" />\n\n----------[ НАЙТИ ]------------------------------------------------------------------------------\n\nbbcode.addTag(\"codeSpoiler\", \"spoiler\", null, \"\",  ctrl);\n\n----------[ ВСТАВИТЬ ПОСЛЕ ]---------------------------------------------------------------------\n\nbbcode.addTag(\"codeLightVideo\", \"lightvideo\", null, \"V\", ctrl);\n\n----------[ СОХРАНИТЬ ВСЕ ]-----------------------------------------------------------------------[/PHP][/SPOILER]",
