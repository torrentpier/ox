      "is_staff": false,
      "last_edit_date": 0,
      "message_parsed": "для XBTT<br />\nдобавляем cron задачу из админки<br />\nincludes/cron/goldday.php<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&lt;?php\nif (!defined(&#039;BB_ROOT&#039;)) die(basename(__FILE__));\n\nif ($bb_cfg[&#039;goldday&#039;] == true )\n{\n    DB()-&gt;query(&#039;\n        UPDATE &#039; . BB_BT_TORRENTS . &#039;\n        set tor_type = 3\n        WHERE tor_type = 0\n    &#039;);\n    DB()-&gt;query(&#039;\n        UPDATE &#039; . BB_BT_TORRENTS . &#039;\n        set tor_type = 4\n        WHERE tor_type = 2\n    &#039;);\n}\nelse\n{\n    DB()-&gt;query(&#039;\n        UPDATE &#039; . BB_BT_TORRENTS . &#039;\n        set tor_type = 0\n        WHERE tor_type = 3;\n    &#039;);\n    DB()-&gt;query(&#039;\n        UPDATE &#039; . BB_BT_TORRENTS . &#039;\n        set tor_type = 2\n        WHERE tor_type = 4;\n    &#039;);\n}</pre>xbt_tracker.conf<br />\n<pre class=\"xfBb-code\" data-lang=\"\">column_files_dl_percent    = (select case tor.tor_type when 1 then 0 when 2 then 50 else 100 end from bb_bt_torrents tor where tor.topic_id=bt.topic_id) as dl_percent\n\nМеняем на\n\ncolumn_files_dl_percent    = (select case tor.tor_type when 4 then 0 when 3 then 0 when 1 then 0 when 2 then 50 else 100 end from bb_bt_torrents tor where tor.topic_id=bt.topic_id) as dl_percent</pre>",
      "message_state": "visible",
      "position": 7,
      "post_date": 1325896286,
      "user_id": 619,
      "user_title": "User",
      "username": "volkodav2000"
    },
