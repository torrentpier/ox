      "last_edit_date": 0,
      "message_parsed": "показываю лёгкий способ, как сделать золотые дни на трекере:<br />\nbt/announce.php<br />\nНайти<br />\n<pre class=\"xfBb-code\" data-lang=\"\">$sql .= ($downloaded != $lp_info[&#039;downloaded&#039;]) ? &quot;, downloaded = $downloaded&quot; : &#039;&#039;;</pre>Заменить на<br />\n<pre class=\"xfBb-code\" data-lang=\"\">  if ($bb_cfg[&#039;goldday&#039;] == true ) {\n  $sql .= ($downloaded != $lp_info[&#039;downloaded&#039;]) ? &quot;, downloaded = 0&quot; : &#039;&#039;;\n}\nelse {\n  $sql .= ($downloaded != $lp_info[&#039;downloaded&#039;]) ? &quot;, downloaded = $downloaded&quot; : &#039;&#039;;\n}</pre>config.php<br />\nв Конце Файла добавить<br />\n<pre class=\"xfBb-code\" data-lang=\"\">$bb_cfg[&#039;goldday&#039;] = true;  // True или ничего</pre>в page_header.tpl<br />\nпосле<br />\n<pre class=\"xfBb-code\" data-lang=\"\">&lt;!-- ENDIF / SHOW_ONLY_NEW_MENU --&gt;\n\n&lt;!--/menus--&gt;</pre>вставить<br />\n<pre class=\"xfBb-code\" data-lang=\"\">&lt;!-- IF $bb_cfg[&#039;goldday&#039;] --&gt;\n&lt;div class=&quot;spacer&quot;&gt;&amp;nbsp;&lt;/div&gt;\n&lt;div align=&quot;center&quot;&gt;\n    &lt;font color=&quot;666666&quot;&gt;&lt;b&gt;[ {L_FREELEECH} ]&lt;/b&gt;&lt;/font&gt;\n&lt;/div&gt;\n&lt;!-- ENDIF --&gt;</pre>в ланги<br />\n<pre class=\"xfBb-code\" data-lang=\"\">$lang[&#039;FREELEECH&#039;] = &#039;Сегодня идет свободное скачивание без начисления Download&#039;;\nenglish\n$lang[&#039;FREELEECH&#039;] = &#039;Today is free to download without increasing Download&#039;;</pre>",
