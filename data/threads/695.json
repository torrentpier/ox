SERT INTO bb_user_view &quot;. $sql);\n}\nelse\n{\nif($time &lt; (TIMENOW - 300))\n{\nDB()-&gt;query(&quot;UPDATE bb_user_view SET time = &#039;&quot;. TIMENOW .&quot;&#039;\nWHERE user_id = {$profiledata[&#039;user_id&#039;]}\nAND profile_id = {$userdata[&#039;user_id&#039;]}\nLIMIT 1&quot;);\n}\n}\n}</pre> <br />\nостальные сделал и спасибо за мод",
