      "is_admin": false,
      "is_moderator": false,
      "is_staff": true,
      "last_edit_date": 0,
      "message_parsed": "<blockquote class=\"xfBb-quote\" data-name=\"Boltik\">Или я совсем отупел и ничего не понял... Поясните плз...</blockquote>нет не отупел. всё верно, атрибута className тут нет. Кто то в запарке методы jQuery с Javascript попутал. 🙂",
      "message_state": "visible",
      "position": 1,
      "post_date": 1334851829,
