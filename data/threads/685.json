      "id": 19053,
      "is_admin": false,
      "is_moderator": false,
      "is_staff": false,
      "last_edit_date": 0,
      "message_parsed": "Скажите, а может ккто нибуть сделать, типо токого же, только кто просматривает форум?",
      "message_state": "visible",
      "position": 19,
