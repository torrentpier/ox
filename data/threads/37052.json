      "message_parsed": "<a href=\"https://torrentpier.com/members/5626/\">@Kryl</a> <code style=\"font-family: Monaco, 'Andale Mono', 'Courier New', Courier, monospace;\nfont-size: 0.9em;\nfont-style: normal;\nline-height: 1.3em;\nbackground: #BFE6FF;\nborder: 1px solid #C6C6EA;\nborder-radius: 3.5px;\npadding: 1px 3px;\ncolor: #0F4D79;\ndisplay: inline-block;\nmargin-bottom: 2px;\">&lt;img src=&quot;ссылка на картинку&quot; /&gt;</code> типа такого вместо текста.",
