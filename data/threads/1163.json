      "message_parsed": "<b>Автор</b>: TorrentPier II<br />\n <br />\nЗапрос<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">ALTER TABLE `bb_users` ADD `user_political` tinyint(1) NOT NULL DEFAULT &#039;0&#039;;</pre> <br />\n<b>usercp_viewprofile.php </b><br />\n<b>найти </b><br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;SKYPE&#039;                =&gt; $profiledata[&#039;user_skype&#039;],</pre>после<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;POLITICAL&#039;              =&gt; ($profiledata[&#039;user_political&#039;]) ? $lang[&#039;POLITICAL_SELECT&#039;][$profiledata[&#039;user_political&#039;]]: &#039;&#039;,</pre> <br />\n<b>usercp_register.php</b><br />\n<b>найти</b><br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;user_gender&#039;      =&gt; true,</pre><b><br />\nпосле</b><br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;user_political&#039;  =&gt; true,</pre> <br />\n<b>найти </b><br />\n<pre class=\"xfBb-code\" data-lang=\"php\">*  Возраст (edit, reg)</pre><b>перед</b><br />\n<pre class=\"xfBb-code\" data-lang=\"php\">    /**\n    *  Политические взгляды (edit, reg)\n    */       \n    case &#039;user_political&#039;:\n        $political = isset($_POST[&#039;user_political&#039;]) ? (int) $_POST[&#039;user_political&#039;] : $pr_data[&#039;user_political&#039;];\n        if ($submit &amp;&amp; $political != $pr_data[&#039;user_political&#039;])\n        {\n            $pr_data[&#039;user_political&#039;] = $political;\n            $db_data[&#039;user_political&#039;] = $political;\n        }\n        $tp_data[&#039;USER_POLITICAL&#039;] = build_select(&#039;user_political&#039;, array_flip($lang[&#039;POLITICAL_SELECT&#039;]), $pr_data[&#039;user_political&#039;]);\n        break;</pre> <br />\nlang_main.php<br />\nв конец <br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$lang[&#039;POLITICAL&#039;] = &#039;Политические взгляды:&#039;;\n$lang[&#039;POLITICAL_SELECT&#039;] = array(\n    0 =&gt; &#039;Не определилось&#039;,\n    1 =&gt; &#039;Индифферентные&#039;,\n    2 =&gt; &#039;Коммунистические&#039;,\n    3 =&gt; &#039;Социалистические&#039;,\n    4 =&gt; &#039;Умеренные&#039;,\n    5 =&gt; &#039;Либеральные&#039;,\n    6 =&gt; &#039;Консервативные&#039;,\n    7 =&gt; &#039;Монархические&#039;,\n    8 =&gt; &#039;Ультраконсервативные&#039;,\n  9 =&gt; &#039;Либертарианские&#039;,\n);</pre> <br />\n<b>usercp_viewprofile.tpl </b><br />\n<b>найти </b><br />\n<pre class=\"xfBb-code\" data-lang=\"html\">&lt;!-- IF BIRTHDAY --&gt;</pre><b>Перед</b><br />\n<pre class=\"xfBb-code\" data-lang=\"html\"> &lt;!-- IF POLITICAL --&gt;\n&lt;tr&gt;\n&lt;th&gt;{L_POLITICAL}:&lt;/th&gt;\n&lt;td&gt;&lt;b&gt;{POLITICAL}&lt;/b&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;!-- ENDIF --&gt;</pre> <br />\n<b>usercp_register.tpl </b><br />\n<b> найти</b><br />\n<pre class=\"xfBb-code\" data-lang=\"html\">&lt;!-- IF BIRTHDAY --&gt;</pre> перед<br />\n<pre class=\"xfBb-code\" data-lang=\"html\">&lt;tr&gt;\n    &lt;td&gt;Политические взгляды:&lt;/td&gt;\n    &lt;td&gt;{USER_POLITICAL}&lt;/td&gt;\n&lt;/tr&gt;</pre> <a href=\"https://torrentpier.com/attachments/947/\"><img src=\"https://torrentpier.com/data/attachments/0/948-96bf979046e0c9796fad0acf20a6077e.jpg?hash=4YvIEWlBh5\" alt=\"2.webp\" /></a><a href=\"https://torrentpier.com/attachments/948/\"><img src=\"https://torrentpier.com/data/attachments/0/949-688a301c11c50a65e14d79dd471cc1cf.jpg?hash=xMmcvwf4Wb\" alt=\"Снимок.webp\" /></a>",
