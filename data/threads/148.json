      "last_edit_date": 0,
      "message_parsed": "<b>Автор:</b> XANDER-CAGE<br />\n<b>Описание</b>: Название темы , говорит само за себя.... 🙂<br />\n<b>Скрины</b>:<br />\n<img src=\"http://i.imgur.com/tZlTBEL.png\" alt=\"\" /><br />\n<img src=\"http://i.imgur.com/ftxX4YD.png\" alt=\"\" /><br />\nfunction.php в конец вставить<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">// [MOD] Подсветка названий топиков\nfunction topicTitleFormat($string, $act=null)\n{\n// создание алиасов\n$act = ($act == &#039;tracker&#039;) ? &#039;viewforum&#039; : $act;\n$act = ($act == &#039;viewtopic_page_title&#039;) ? &#039;crop&#039; : $act;\n\n//захватываем - &quot;Не захватываем (захватываем) [захватываем если есть]&quot;\n$aPatterns[&#039;more_info&#039;] = &#039;@(\\([^)]+?\\))\\s*(\\[[^]]+?\\])*\\s*$@&#039;;\n\nswitch($act){\n\ncase &#039;viewforum&#039;:\n$sResult = preg_replace($aPatterns[&#039;more_info&#039;], &quot;&lt;span style=&#039;font-weight:normal;background-color:white;&#039;&gt;$0&lt;/span&gt;&quot;, $string);\nbreak;\n\ncase &#039;viewtopic_body&#039;:\n$sResult = preg_replace($aPatterns[&#039;more_info&#039;], &quot;&lt;span style=&#039;font-weight:normal;font-size:14px;&#039;&gt;$0&lt;/span&gt;&quot;, $string);\nbreak;\n\ncase &#039;crop&#039;:\n$sResult = preg_replace($aPatterns[&#039;more_info&#039;], &#039;&#039;, $string);\nbreak;\n\ndefault:\nreturn $string;\n}\n\n// подсвечиваем HDRip|BDRip|HDTVRip CamRip|TS|TC|TeleSynch и текущий год\n$sResult = preg_replace(&quot;@\\s(HDRip|BDRip|HDTVRip)@i&quot;, &quot;&lt;span style=&#039;color:#0089f3&#039;&gt;&lt;b&gt;$0&lt;/b&gt;&lt;/span&gt;&quot;, $sResult);\n$sResult = preg_replace(&quot;@(&quot;.date(&#039;Y&#039;).&quot;)@&quot;, &quot;&lt;u style=&#039;display:inline;background-color:#f7f7f7&#039;&gt;&lt;b&gt;$0&lt;/b&gt;&lt;/u&gt;&quot;, $sResult);\n$sResult = preg_replace(&quot;@\\s(CamRip|TS|TC|TeleSynch)@i&quot;, &quot; &lt;span style=&#039;color:red&#039;&gt;&lt;b&gt;$0&lt;/b&gt;&lt;/span&gt;&quot;, $sResult);\n$sResult = preg_replace(&quot;@\\s(DVDRip|DVDRIP|dvdrip|dvdRip)@i&quot;, &quot; &lt;span style=&#039;color:black&#039;&gt;&lt;b&gt;$0&lt;/b&gt;&lt;/span&gt;&quot;, $sResult);\nreturn $sResult;\n}</pre>Открываем <b>viewforum.php</b>, находим:<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;TOPIC_TITLE&#039; =&gt; wbr($topic[&#039;topic_title&#039;]),</pre>Заменяем на:<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;TOPIC_TITLE&#039; =&gt; topicTitleFormat(wbr($topic[&#039;topic_title&#039;]), &#039;viewforum&#039;),</pre>Открываем <b>viewtopic.php</b>, находим:<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;PAGE_TITLE&#039; =&gt; $topic_title,\n&#039;TOPIC_TITLE&#039; =&gt; wbr($topic_title),</pre>заменяем на:<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;PAGE_TITLE&#039; =&gt; topicTitleFormat($topic_title, &#039;viewtopic_page_title&#039;),\n&#039;TOPIC_TITLE&#039; =&gt; topicTitleFormat(wbr($topic_title), &#039;viewtopic_body&#039;),</pre>Открываем <b>tracker.php</b>, находим:<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;TOPIC_TITLE&#039; =&gt; wbr($tor[&#039;topic_title&#039;]),</pre>Заменяем на:<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;TOPIC_TITLE&#039; =&gt; topicTitleFormat(wbr($tor[&#039;topic_title&#039;]), &#039;tracker&#039;),</pre>",
