      "last_edit_date": 0,
      "message_parsed": "select u.username, count(tor.topic_id) as kol_vo, sum(tor.size) as razmer from bb_bt_torrents tor, bb_users u where tor.poster_id = u.user_id and tor.reg_time &gt; &quot;. (TIMENOW - 86400) .&quot; group by tor.poster_id",
