      "message_parsed": "<span style=\"color: #000000\"><span style=\"font-size: 12px\"><b><span style=\"font-family: 'Verdana'\">Автор: </span></b>RusTrek</span></span><br />\n<span style=\"color: #000000\"><span style=\"font-size: 12px\">Описание: </span></span><span style=\"color: #000000\"><span style=\"font-size: 12px\">Делаем запрос из админки</span></span><br />\n<span style=\"color: #000000\"><span style=\"font-size: 12px\">Мод позволяет выполнять SQL запросы из админки.</span></span><br />\n<span style=\"color: #000000\"><span style=\"font-size: 12px\">Может нужен кому.</span></span><br />\n<span style=\"color: #000000\"><span style=\"font-size: 12px\">В принципе очень удобная весчь.</span></span><br />\n<span style=\"color: #000000\"><span style=\"font-size: 12px\">Перед установкой обязательно делаем бекапы!!! </span></span><br />\n <br />\n <br />\n<span style=\"font-family: 'Verdana'\"><span style=\"color: #000000\"><span style=\"font-size: 12px\">открываем <b>language/lang_russian/lang_admin.php </b></span></span></span><br />\n<pre class=\"xfBb-code\" data-lang=\"php\">// BEGIN DBQuery MOD\n$lang[&#039;FOUNDER_ONLY&#039;] = &#039;Только Супер админ может сделать SQL запрос к базе данных!&#039;;\n$lang[&#039;QUERY_SUCCESS&#039;] = &#039;Запрос прошел успешно!&#039;;\n$lang[&#039;QUERY_DATABASE&#039;] = &#039;Запрос к базе данных&#039;;\n$lang[&#039;SQL_TITLE&#039;] = &#039;SQL Query MOD&#039;;\n$lang[&#039;SQL_EXPLAIN&#039;] = &#039;Этот MOD позволяет сделать SQL запросов через панель управления администратора&#039;;\n$lang[&#039;BACKUP_DB&#039;] = &#039;Сделайте обязательно бекап перед выполнением запроса к базе!&#039;;\n$lang[&#039;RESET&#039;] = &#039;Сброс&#039;;\n$lang[&#039;QUERY_FAIL&#039;] = &#039;Ваш SQL-запрос не может быть завершен, пожалуйста, попробуйте еще раз! &#039;;\n$lang[&#039;QUERY_NAME&#039;] = &#039;sql&#039;;\n// END DBQuery MOD</pre>",
