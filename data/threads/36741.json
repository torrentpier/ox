      "last_edit_date": 1494626268,
      "message_parsed": "<a href=\"https://torrentpier.com/members/1/\">Exile</a>, как я понял, вот кусок кода, где содержится ЛС победителю (totalz.php 370 строка)<br />\n<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">                $message    = &#039;&#039; ? sprintf($lang[&#039;TZ_YOUR_WIN&#039;] . $bablos . &quot;&lt;/b&gt; &quot; . $points_name . $lang[&#039;TZ_IN_EVENT&#039;] . &quot;&#039;&quot;.$name_sob . &quot;&#039;&quot; . $lang[&#039;TZ_YOUR_KOEFF&#039;] . sprintf(&quot;%.2f&quot;, $bablos / $real_stavka_array[$v]) . $lang[&#039;TZ_OTHER_IN_ARCH3&#039;]) : sprintf($lang[&#039;TZ_YOUR_WIN2&#039;] . $bablos . &quot; &quot; . $points_name . $lang[&#039;TZ_IN_EVENT2&#039;] . &quot;&#039;&quot; . $name_sob . &quot;&#039;&quot; . $lang[&#039;TZ_YOUR_KOEFF2&#039;] . sprintf(&quot;%.2f&quot;, $bablos / $real_stavka_array[$v]) . $lang[&#039;TZ_OTHER_IN_ARCH4&#039;]);\n                totalz_pm($dest, $subject, $message);</pre><br />\nА как сделать из этого ЛС проигравшему?",
