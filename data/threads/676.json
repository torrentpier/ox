      "username": "RomM1"
    },
    {
      "attach_count": 0,
      "attachments": [],
      "id": 8706,
      "is_admin": false,
      "is_moderator": false,
      "is_staff": false,
      "last_edit_date": 0,
      "message_parsed": "<span style=\"font-size: 12px\"><span style=\"font-family: 'verdana'\"><span style=\"color: #000000\">Лечение: в настройках MYSQL отключить STRICT_TRANS_TABLES .</span></span></span><br />\n<span style=\"font-size: 12px\"><span style=\"font-family: 'verdana'\"><span style=\"color: #000000\">в my.ini строку: </span></span></span><br />\n<span style=\"font-size: 12px\"><span style=\"font-family: 'verdana'\"><span style=\"color: #000000\">sql-mode=&quot;STRICT_TRANS_TABLES,NO_AUTO_CREATE_USER,NO_E NGINE_SUBSTITUTION&quot;</span></span></span><br />\n<span style=\"font-size: 12px\"><span style=\"font-family: 'verdana'\"><span style=\"color: #000000\">заменяем на</span></span></span><br />\n<span style=\"font-size: 12px\"><span style=\"font-family: 'verdana'\"><span style=\"color: #000000\">sql-mode=&quot;NO_AUTO_CREATE_USER,NO_E NGINE_SUBSTITUTION&quot;</span></span></span>",
