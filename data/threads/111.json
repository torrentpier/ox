      "is_admin": false,
      "is_moderator": false,
      "is_staff": true,
      "last_edit_date": 0,
      "message_parsed": "DHT можно включить в админке TorrentPier - Настройки форумов - Запретить DHT сети<br />\n<br />\n <a href=\"http://tinyurl.com/oxqf8f\" target=\"_blank\" class=\"link link--external\" rel=\"nofollow ugc noopener\">http://tinyurl.com/oxqf8f</a>",
      "message_state": "visible",
