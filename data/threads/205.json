      "message_parsed": "Так... вроде бы оттестил. Все работает.<br />\n <br />\n<b>SQL</b><br />\n<pre class=\"xfBb-code\" data-lang=\"php\">ALTER TABLE `bb_forums` ADD `forum_url` TEXT NOT NULL AFTER `forum_desc`</pre> <br />\n<b>index.php</b><br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$cat_title_html = $forums[&#039;cat_title_html&#039;];\n$forum_name_html = $forums[&#039;forum_name_html&#039;];</pre> <br />\nпосле вставить<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$forum_url = $forums[&#039;forum_url&#039;];</pre> <br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">if (!$fname_html =&amp; $forum_name_html[$fid])\n        {\n            continue;\n        }</pre> <br />\nпосле вставить<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$furl =&amp; $forum_url[$fid];</pre> <br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;FORUM_ID&#039;          =&gt; $fid,\n&#039;FORUM_NAME&#039;        =&gt; $fname_html,</pre> <br />\nпосле вставить<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;FORUM_URL&#039;            =&gt; $furl,</pre> <br />\n<b>index.tpl</b><br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&lt;h4 class=&quot;forumlink&quot;&gt;&lt;a href=&quot;{FORUM_URL}{c.f.FORUM_ID}&quot;&gt;{c.f.FORUM_NAME}&lt;/a&gt;&lt;/h4&gt;</pre> <br />\nзаменить на<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&lt;!-- IF c.f.FORUM_URL --&gt;\n&lt;h4 class=&quot;forumlink&quot;&gt;&lt;a href=&quot;{c.f.FORUM_URL}&quot;&gt;{c.f.FORUM_NAME}&lt;/a&gt;&lt;/h4&gt;\n&lt;!-- ELSE --&gt;\n&lt;h4 class=&quot;forumlink&quot;&gt;&lt;a href=&quot;{FORUM_URL}{c.f.FORUM_ID}&quot;&gt;{c.f.FORUM_NAME}&lt;/a&gt;&lt;/h4&gt;\n&lt;!-- ENDIF --&gt;</pre> <br />\n<b>build_cat_forums.php</b><br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;cat_title_html&#039;  =&gt; array(),\n&#039;forum_name_html&#039; =&gt; array(),</pre> <br />\nдобавить после<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;forum_url&#039; =&gt; array(),</pre> <br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$data[&#039;f&#039;][$fid] = array_intersect_key($row, $forum_store_fields);\n$data[&#039;forum_name_html&#039;][$fid] = htmlCHR($row[&#039;forum_name&#039;]);</pre> <br />\nвставить после<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$data[&#039;forum_url&#039;][$fid] = htmlCHR($row[&#039;forum_url&#039;]);</pre> <br />\n<b>lang_admin.php</b><br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$lang[&#039;FORUM_DESC&#039;] = &#039;Описание&#039;;</pre> <br />\nпосле вставить<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$lang[&#039;FORUM_URL&#039;] = &#039;Внешняя ссылка&#039;;</pre> <br />\n<b>admin_forums.tpl</b><br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&lt;tr&gt;\n&lt;td class=&quot;row1&quot;&gt;{L_FORUM_DESC}&lt;/td&gt;\n&lt;td class=&quot;row2&quot;&gt;&lt;textarea style=&quot;width: 96%;&quot; rows=&quot;2&quot; wrap=&quot;virtual&quot; name=&quot;forumdesc&quot; class=&quot;post&quot;&gt;{DESCRIPTION}&lt;/textarea&gt;&lt;/td&gt;\n&lt;/tr&gt;</pre> <br />\nпосле вставить<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&lt;tr&gt;\n&lt;td class=&quot;row1&quot;&gt;{L_FORUM_URL}&lt;/td&gt;\n&lt;td class=&quot;row2&quot;&gt;&lt;textarea style=&quot;width: 96%;&quot; rows=&quot;2&quot; wrap=&quot;virtual&quot; name=&quot;forumurl&quot; class=&quot;post&quot;&gt;{FORUMURL}&lt;/textarea&gt;&lt;/td&gt;\n&lt;/tr&gt;</pre> <br />\n<b>admin_forums.php</b><br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$forumname = $row[&#039;forum_name&#039;];\n$forumdesc = $row[&#039;forum_desc&#039;];</pre> <br />\nпосле вставить<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$forumurl = $row[&#039;forum_url&#039;];</pre> <br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;FORUM_NAME&#039; =&gt; htmlCHR($forumname),\n&#039;DESCRIPTION&#039; =&gt; htmlCHR($forumdesc),</pre> <br />\nпосле вставить<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">&#039;FORUMURL&#039; =&gt; htmlCHR($forumurl),</pre> <br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$forum_name = DB()-&gt;escape(trim($_POST[&#039;forumname&#039;]));\n$forum_desc = DB()-&gt;escape(trim($_POST[&#039;forumdesc&#039;]));</pre> <br />\nвставить ниже<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$forum_url = DB()-&gt;escape(trim($_POST[&#039;forumurl&#039;]));</pre> <br />\nнайти<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$columns = &#039; forum_name,  cat_id,  forum_desc, forum_order,  forum_status,  prune_days,  forum_parent,  show_on_index,  forum_display_sort,  forum_display_order,  forum_tpl_id,  allow_reg_tracker,  allow_porno_topic,  self_moderated&#039;. $field_sql;\n$values = &quot;&#039;$forum_name&#039;, $cat_id, &#039;$forum_desc&#039;, $forum_order, $forum_status, $prune_days, $forum_parent, $show_on_index, $forum_display_sort, $forum_display_order, $forum_tpl_id, $allow_reg_tracker, $allow_porno_topic, $self_moderated&quot;. $value_sql;</pre> <br />\nЗАМЕНИТЬ на<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">$columns = &#039; forum_name,  cat_id,  forum_desc, forum_url, forum_order,  forum_status,  prune_days,  forum_parent,  show_on_index,  forum_display_sort,  forum_display_order,  forum_tpl_id,  allow_reg_tracker,  allow_porno_topic,  self_moderated&#039;. $field_sql;\n$values = &quot;&#039;$forum_name&#039;, $cat_id, &#039;$forum_desc&#039;, &#039;$forum_url&#039;, $forum_order, $forum_status, $prune_days, $forum_parent, $show_on_index, $forum_display_sort, $forum_display_order, $forum_tpl_id, $allow_reg_tracker, $allow_porno_topic, $self_moderated&quot;. $value_sql;</pre> <br />\n<a href=\"https://torrentpier.com/attachments/1605/\"><img src=\"https://torrentpier.com/data/attachments/1/1606-c0e20930a757a6d654d91dad9769db33.jpg?hash=d5jHQHKhhE\" alt=\"2.webp\" /></a><a href=\"https://torrentpier.com/attachments/1606/\"><img src=\"https://torrentpier.com/data/attachments/1/1607-823e093c24aa250199491b2c954b0060.jpg?hash=RU8vT7d0Lb\" alt=\"1.webp\" /></a>",
