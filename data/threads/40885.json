          "local_path": null,
          "r2_key": "attachments/3481/косяк.webp",
          "src_url": "https://torrentpier.com/attachments/kosak-webp.3481/",
          "thumbnail_url": "https://torrentpier.com/data/attachments/3/3485-e7411510805a2ab5e6e679bc393d88d8.jpg?hash=-mEOshadtB",
