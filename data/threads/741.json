ot; alt=&quot;&quot; border=&quot;0&quot; onload=&quot;imgFit(this, 100);&quot; onClick=&quot;return imgFit(this, 100);&quot; max-height=&quot;&#039;. $height .&#039;&quot; max-width=&quot;&#039;. $width .&#039;&quot; /&gt;&#039; : &#039;&#039;;\n                break;\n            case USER_AVATAR_GALLERY:\n                $user_avatar = ( $bb_cfg[&#039;allow_avatar_local&#039;] ) ? &#039;&lt;img src=&quot;&#039;. $bb_cfg[&#039;avatar_gallery_path&#039;] .&#039;/&#039;. $avatar .&#039;&quot; alt=&quot;&quot; border=&quot;0&quot; max-height=&quot;&#039;. $height .&#039;&quot; max-width=&quot;&#039;. $width .&#039;&quot; /&gt;&#039; : &#039;&#039;;\n                break;\n        }\n    }\n    return $user_avatar;\n}</pre>",
