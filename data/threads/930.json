      "is_admin": false,
      "is_moderator": false,
      "is_staff": false,
      "last_edit_date": 0,
      "message_parsed": "<b>qqq</b>, <span style=\"color: #ff0000\"><span style=\"font-size: 18px\"><b>Администратор всегда - прав! Спорить бесполезно даже, если ты прав на 200%!</b></span></span>",
