      "message_parsed": "как-то так...<br />\n <br />\n<b>functions_torrent.php</b><br />\nНайти:<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">        $columns = &#039; info_hash,      post_id,  poster_id,  topic_id,  forum_id,  attach_id,    size,  reg_time,  tor_status&#039;;\n        $values = &quot;&#039;$info_hash_sql&#039;, $post_id, $poster_id, $topic_id, $forum_id, $attach_id, &#039;$size&#039;, $reg_time, $tor_status&quot;;</pre>Заменить на:<br />\n<pre class=\"xfBb-code\" data-lang=\"php\">        $tor_type = TOR_TYPE_GOLD;\n        $columns = &#039; info_hash,      post_id,  poster_id,  topic_id,  forum_id,  attach_id,    size,  reg_time,  tor_status,  tor_type&#039;;\n        $values = &quot;&#039;$info_hash_sql&#039;, $post_id, $poster_id, $topic_id, $forum_id, $attach_id, &#039;$size&#039;, $reg_time, $tor_status, $tor_type&quot;;</pre> <br />\nили <br />\n<b>SQL:</b><br />\n<pre class=\"xfBb-code\" data-lang=\"\">ALTER TABLE `bb_bt_torrents` MODIFY COLUMN `tor_type` tinyint(1) NOT NULL DEFAULT 1</pre>",
