      "id": 35065,
      "is_admin": false,
      "is_moderator": false,
      "is_staff": false,
      "last_edit_date": 0,
      "message_parsed": "<b>Dr_Brown</b>, так все верно пишет. <a href=\"http://www.домен.com\" target=\"_blank\" class=\"link link--external\" rel=\"nofollow ugc noopener\">www.домен.com</a> и домен.com - это разные домены в понимании ПС",
      "message_state": "visible",
