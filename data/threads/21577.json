      "is_admin": false,
      "is_moderator": false,
      "is_staff": true,
      "last_edit_date": 0,
      "message_parsed": "Запросом. <br />\n6cf01fb6a1b515889ddc4d58602ea272 = 123123q<br />\nINSERT INTO bb_users (username, user_email, user_password) VALUES (&#039;Ольга Баркина-Гопфауф&#039;, &#039;<a href=\"mailto:email1@email.com\">email1@email.com</a>&#039;, &#039;6cf01fb6a1b515889ddc4d58602ea272&#039;);",
      "message_state": "visible",
      "position": 1,
      "post_date": 1385625389,
      "user_id": 3170,
      "user_title": "User",
      "username": "drew"
    },
    {
