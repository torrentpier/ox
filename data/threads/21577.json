      "username": "Lapas"
    },
    {
      "attach_count": 0,
      "attachments": [],
      "id": 52990,
      "is_admin": false,
      "is_moderator": false,
      "is_staff": true,
      "last_edit_date": 0,
      "message_parsed": "<b>Lapas</b>, в бд. Если лень, то можешь на пиво кинуть денег мне и я тебе напишу полный список запросов. Если что в лс пиши.",
      "message_state": "visible",
      "position": 3,
      "post_date": 1385640948,
      "user_id": 3170,
      "user_title": "User",
      "username": "drew"
    },
    {
      "attach_count": 0,
      "attachments": [],
      "id": 53188,
      "is_admin": false,
      "is_moderator": false,
      "is_staff": false,
      "last_edit_date": 0,
      "message_parsed": "Пробовал сделать запрос в БД, но добавляет он лишь 639 строк, а у меня около 5 тыс. их.<br />\nСоздал текстовик с запросами.<br />\nВида:<br />\nINSERT INTO bb_users (username, user_email, user_password) VALUES (&#039;Ольга Баркина-Гопфауф&#039;, &#039;<a href=\"mailto:email1@email.com\">email1@email.com</a>&#039;, &#039;6cf01fb6a1b515889ddc4d58602ea272&#039;);<br />\nINSERT INTO bb_users (username, user_email, user_password) VALUES (&#039;Ольга Баркина-Гопфауф&#039;, &#039;<a href=\"mailto:email1@email.com\">email1@email.com</a>&#039;, &#039;6cf01fb6a1b515889ddc4d58602ea272&#039;);<br />\nINSERT INTO bb_users (username, user_email, user_password) VALUES (&#039;Ольга Баркина-Гопфауф&#039;, &#039;<a href=\"mailto:email1@email.com\">email1@email.com</a>&#039;, &#039;6cf01fb6a1b515889ddc4d58602ea272&#039;);<br />\nINSERT INTO bb_users (username, user_email, user_password) VALUES (&#039;Ольга Баркина-Гопфауф&#039;, &#039;<a href=\"mailto:email1@email.com\">email1@email.com</a>&#039;, &#039;6cf01fb6a1b515889ddc4d58602ea272&#039;);<br />\n и т.к. (конечно разные имена и емайлы).<br />\n <br />\nКак можно импортировать этот текстовик прямо в БД? Что нужно внутрь дописать что бы без проблем импортировался ?",
      "message_state": "visible",
      "position": 4,
      "post_date": 1385802272,
      "user_id": 4853,
      "user_title": "User",
      "username": "Lapas"
    },
    {
      "attach_count": 0,
      "attachments": [],
      "id": 53208,
      "is_admin": false,
      "is_moderator": false,
      "is_staff": false,
      "last_edit_date": 0,
      "message_parsed": "можно. файлик в кодировке utf8 без bom + с расширением .sql для верности.<br />\nзапрос можно составить всего один по такому шаблону:<br />\n<pre class=\"xfBb-code\" data-lang=\"\">INSERT INTO bb_users (username, user_email, user_password) VALUES\n(&#039;Ольга Баркина-Гопфауф&#039;, &#039;email1@email.com&#039;, &#039;6cf01fb6a1b515889ddc4d58602ea272&#039;),\n(&#039;Ольга Баркина-Гопфауф&#039;, &#039;email1@email.com&#039;, &#039;6cf01fb6a1b515889ddc4d58602ea272&#039;),\n...\n(&#039;Ольга Баркина-Гопфауф&#039;, &#039;email1@email.com&#039;, &#039;6cf01fb6a1b515889ddc4d58602ea272&#039;);</pre>",
      "message_state": "visible",
      "position": 5,
      "post_date": 1385824101,
      "user_id": 0,
      "user_title": "",
      "username": "Gemini_13"
    },
