      "attachments": [],
      "id": 52965,
      "is_admin": false,
      "is_moderator": false,
      "is_staff": false,
      "last_edit_date": 0,
      "message_parsed": "Куда запрос этот вводить? <br />\n <br />\nКаждую строку вручную получается так делать?",
      "message_state": "visible",
      "position": 2,
      "post_date": 1385630795,
      "user_id": 4853,
