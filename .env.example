# XenForo REST API
XF_API_URL=https://torrentpier.com/api
XF_API_KEY=
XF_API_USER=1

# Cloudflare R2 (S3-compatible) — used by the attachment mirror step
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=torrentpier-archive
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://files.archive.example.com

# Cloudflare API token — used to provision R2 bucket / Worker / D1 via wrangler
CF_API_TOKEN=
CF_ACCOUNT_ID=
