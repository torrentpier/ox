# XenForo REST API
XF_API_URL=https://torrentpier.com/api
XF_API_KEY=
XF_API_USER=1
# Optional override of the exporter's request rate (default 3 rps)
# XF_API_RPS=3

# Cloudflare R2 (S3-compatible) — used by the mirror stage (boto3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=torrentpier-archive
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://files-ox.torrentpier.com
# Optional override of the mirror's download rate (default 2 rps)
# MIRROR_RPS=2

# Cloudflare API token — used to provision R2 bucket / Worker / D1 via wrangler
# (one-time setup; not consumed by Python code in this repo)
CF_API_TOKEN=
CF_ACCOUNT_ID=
